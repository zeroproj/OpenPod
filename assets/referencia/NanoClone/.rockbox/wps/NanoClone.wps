#
#NO STATUS BAR
%wd
#
#IMAGES
%X(bg-176x132x16.bmp)
#%xl(A,AA Bottom.bmp,5,87)
#%xl(B,AA Left.bmp,5,42)
#%xl(C,AA Right.bmp,52,42)
%xl(D,battery.bmp,0,0,10)
%xl(G,playbtns.bmp,0,0,5)
%xl(I,shuffle.bmp,0,0)
%xl(F,hold.bmp,0,0)
%xl(H,repeat.bmp,0,0,4)
%xl(E,hdd.bmp,0,0,6)
%xl(J,vol-l.bmp,6,100)
%xl(K,vol-r.bmp,88,100)
#
#ALBUM ART/INFO HANDLING
%?C<%Vd(a)|%Vd(b)>
#
#DISK ACCESS AND PLAYMODE HANDLING
%?lh<%Vd(c)|%Vd(e)>
#
#8 BAR AND PROGRESS BAR HANDLING
%?mv(2.0)<%Vd(f)%xd(J)%xd(K)|%Vd(d)>
