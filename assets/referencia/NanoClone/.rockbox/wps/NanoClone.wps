#ALBUM INFO [WITH ALBUM ART]
%ax%Vl(a,58,38,112,53,-)%Vf(000000)%Vb(FFFFFF)
%al%s%?it<%it|%fm>
%al%s%?ia<%ia|%Sx(Artist) %Sx(Unknown)>
%al%s%?id<%id%?iy< %(%iy%)|>|%Sx(Album) %Sx(Unknown)>
#
#ALBUM INFO [WITHOUT ALBUM ART]
%Vl(b,7,38,162,53,-)%Vf(000000)%Vb(FFFFFF)
%ac%s%?it<%it|%fm>
%ac%s%?ia<%ia|%Sx(Artist) %Sx(Unknown)>
%ac%s%?id<%id%?iy< %(%iy%)|>|%Sx(Album) %Sx(Unknown)>
#
#BATTERY ICON AND CHARGE ANIMATION
%V(153,2,21,13,-)%Vb(FFFFFF)
%?bp<%?bc<%xd(Da)|%xd(Db)>|%?bl<|%xd(Dc)|%xd(Dd)|%xd(De)|%xd(Df)|%xd(Dg)|%xd(Dh)|%xd(Di)|%xd(Dj)>>
